PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database configuration (MySQL or PostgreSQL supported via Prisma)
# For local MySQL: mysql://root:password@localhost:3306/homefinder
# For PostgreSQL: postgresql://postgres:password@localhost:5432/homefinder?schema=public
DATABASE_URL="mysql://root:manager@localhost:3306/homefinder"

# JWT Secret for cookie authentication
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=7d

# Google Maps API key
GOOGLE_MAPS_SERVER_API_KEY=

# Cloudinary configuration (Optional - uses local file storage when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP configuration (Optional - logs to console when empty)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="HomeFinder <no-reply@homefinder.com>"

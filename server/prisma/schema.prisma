datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TENANT
  OWNER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  VILLA
  STUDIO
  PENTHOUSE
}

enum FurnishingStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RENTED
  PAUSED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  NEW
  RESPONDED
  CLOSED
}

enum VisitStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String        @id @default(uuid())
  fullName        String
  email           String        @unique
  phone           String?       @unique
  passwordHash    String
  role            Role          @default(TENANT)
  accountStatus   AccountStatus @default(ACTIVE)
  avatarUrl       String?       @db.Text
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  properties         Property[]          @relation("OwnerProperties")
  favorites          Favorite[]
  inquiries          Inquiry[]           @relation("TenantInquiries")
  visitRequests      VisitRequest[]      @relation("TenantVisits")
  notifications      Notification[]
  reports            PropertyReport[]    @relation("UserReports")
  ownerVerification  OwnerVerification?
  auditLogs          AuditLog[]          @relation("UserAudits")
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([role])
}

model Property {
  id               String           @id @default(uuid())
  ownerId          String
  title            String
  description      String           @db.Text
  propertyType     PropertyType     @default(APARTMENT)
  address          String           @db.Text
  locality         String
  city             String
  state            String
  postalCode       String
  latitude         Float
  longitude        Float
  monthlyRent      Decimal          @db.Decimal(12, 2)
  securityDeposit  Decimal          @db.Decimal(12, 2)
  bedrooms         Int              @default(1)
  bathrooms        Int              @default(1)
  area             Int              // Square feet
  furnishing       FurnishingStatus @default(SEMI_FURNISHED)
  availableFrom    DateTime         @default(now())
  status           PropertyStatus   @default(AVAILABLE)
  moderationStatus ModerationStatus @default(PENDING)
  rejectionReason  String?          @db.Text
  viewsCount       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Optional hierarchical location links (LGD India)
  stateId          String?
  districtId       String?
  subdistrictId    String?
  villageId        String?

  owner            User             @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)
  stateRel         State?           @relation(fields: [stateId], references: [id], onDelete: SetNull)
  districtRel      District?        @relation(fields: [districtId], references: [id], onDelete: SetNull)
  subdistrictRel   Subdistrict?     @relation(fields: [subdistrictId], references: [id], onDelete: SetNull)
  villageRel       Village?         @relation(fields: [villageId], references: [id], onDelete: SetNull)
  images           PropertyImage[]
  amenities        PropertyAmenity[]
  favorites        Favorite[]
  inquiries        Inquiry[]
  visitRequests    VisitRequest[]
  reports          PropertyReport[]

  @@index([ownerId])
  @@index([city])
  @@index([locality])
  @@index([state])
  @@index([stateId])
  @@index([districtId])
  @@index([subdistrictId])
  @@index([villageId])
  @@index([monthlyRent])
  @@index([status])
  @@index([moderationStatus])
  @@index([latitude, longitude])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String   @db.Text
  publicId   String?
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Amenity {
  id         String            @id @default(uuid())
  name       String            @unique
  iconKey    String
  category   String            @default("GENERAL")

  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Inquiry {
  id         String        @id @default(uuid())
  propertyId String
  tenantId   String
  message    String        @db.Text
  ownerReply String?       @db.Text
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     User          @relation("TenantInquiries", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
}

model VisitRequest {
  id         String      @id @default(uuid())
  propertyId String
  tenantId   String
  visitDate  DateTime
  timeSlot   String      // e.g., "10:00 AM - 11:00 AM"
  notes      String?     @db.Text
  ownerNotes String?     @db.Text
  status     VisitStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     User        @relation("TenantVisits", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([visitDate])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // INQUIRY, VISIT, MODERATION, SYSTEM
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model PropertyReport {
  id          String       @id @default(uuid())
  propertyId  String
  reporterId  String
  reason      String
  details     String?      @db.Text
  status      ReportStatus @default(PENDING)
  adminNotes  String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporter    User         @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([reporterId])
  @@index([status])
}

model OwnerVerification {
  id              String             @id @default(uuid())
  userId          String             @unique
  documentType    String             // e.g. "GOVT_ID", "UTILITY_BILL", "PROPERTY_DEED"
  documentUrl     String             @db.Text
  status          VerificationStatus @default(PENDING)
  rejectionReason String?            @db.Text
  adminNotes      String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id            String   @id @default(uuid())
  performedById String?
  action        String
  entityType    String
  entityId      String?
  details       String?  @db.Text
  ipAddress     String?
  createdAt     DateTime @default(now())

  performedBy   User?    @relation("UserAudits", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([performedById])
  @@index([action])
  @@index([entityType])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model State {
  id         String     @id @default(uuid())
  code       String     @unique
  name       String     @unique
  type       String     @default("STATE")
  districts  District[]
  properties Property[]

  @@index([name])
}

model District {
  id           String        @id @default(uuid())
  stateId      String
  name         String
  headquarters String?
  state        State         @relation(fields: [stateId], references: [id], onDelete: Cascade)
  subdistricts Subdistrict[]
  properties   Property[]

  @@unique([stateId, name])
  @@index([stateId])
  @@index([name])
}

model Subdistrict {
  id         String     @id @default(uuid())
  districtId String
  name       String
  district   District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  villages   Village[]
  properties Property[]

  @@unique([districtId, name])
  @@index([districtId])
  @@index([name])
}

model Village {
  id            String      @id @default(uuid())
  subdistrictId String
  name          String
  isUrban       Boolean     @default(false)
  subdistrict   Subdistrict @relation(fields: [subdistrictId], references: [id], onDelete: Cascade)
  properties    Property[]

  @@index([subdistrictId])
  @@index([name])
}

model PincodeDirectory {
  id           String   @id @default(uuid())
  pincode      String
  officeName   String
  taluk        String?
  districtName String
  stateName    String
  latitude     Float?
  longitude    Float?

  @@index([pincode])
  @@index([districtName])
  @@index([stateName])
}

